{
  "name": "paper-studio-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/render/page/tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "validate": "node src/cli/validate.ts",
    "verify": "npm run typecheck && npm test && npm run validate",
    "render": "node src/cli/render.ts",
    "audit": "node src/cli/audit.ts",
    "check:renderer": "node src/cli/check-renderer.ts",
    "sheet": "node src/cli/sheet.ts",
    "check:bake": "node src/cli/check-bake.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "0.21.0",
    "puppeteer-core": "25.18.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
